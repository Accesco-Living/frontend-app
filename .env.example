# ==============================================================================
# ACCESCO LIVING - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Google Maps & Places API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# AI Models
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Primary Supabase Instance (Auth, Blogs, Games, Grokly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Swadisht Supabase Instance
SWADISHT_SUPABASE_URL=https://your-swadisht-project.supabase.co
SWADISHT_SUPABASE_ANON_KEY=your-swadisht-anon-key

# Vendor Supabase Instance
VENDOR_SUPABASE_URL=https://your-vendor-project.supabase.co
VENDOR_SUPABASE_ANON_KEY=your-vendor-anon-key

# Firebase API Keys
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_ANDROID_API_KEY=YOUR_FIREBASE_ANDROID_API_KEY

# Local API Endpoints
BLOG_API_URL=http://localhost:5000/api/blogs

# Virtual Discovery Backend Configuration
DISCOVERY_DATABASE_URL=postgresql://postgres:password@localhost:5432/accesco_discovery
DISCOVERY_SECRET_KEY=your-discovery-secret-key
BRAND_API_KEY=dev-brand-key
INTERNAL_API_KEY=dev-internal-key

# Chatbot Database Configuration
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
CHATBOT_SECRET_KEY=your-chatbot-secret

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
